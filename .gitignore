.vs/
bin/
obj/
*.user

# Disposable QA runtime evidence; retain directory placeholders only.
/QA/TestRuns/*
!/QA/TestRuns/.gitkeep
/QA/Reports/*
!/QA/Reports/.gitkeep
/QA/Screenshots/*
!/QA/Screenshots/.gitkeep

QA/Fixtures/*.0001.rvt
QA/Fixtures/*.rvt.backup

# Local agent orchestration runtime state; keep only the directory placeholder.
/AgentOrchestration/Store/*
!/AgentOrchestration/Store/.gitkeep
