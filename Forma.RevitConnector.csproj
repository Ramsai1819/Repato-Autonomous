<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Deployment artifacts and nested worktrees are never project source inputs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);DeploymentCandidates\**;DeploymentBackups\**;.worktrees\**;.release-worktree-*\**;.diagnostic-publish*\**</DefaultItemExcludes>

    <AssemblyName>Repato.Revit</AssemblyName>
    <RootNamespace>Repato.Revit</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>

    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">E:\revit\Revit 2025</RevitInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="QA\ToolQaRegistry.v1.json" LogicalName="Repato.ToolQaRegistry.v1.json" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ConnectorModels.cs" />
    <Compile Remove="ConnectorServer.cs" />
    <Compile Remove="FormaEventHandler.cs" />
    <Compile Remove="QaLaunchAgent\**\*.cs" />
    <Compile Remove="QaLaunchAgent.ProtocolInteropTests\**\*.cs" />
    <Compile Remove="TestRunner.ContractTests\**\*.cs" />
    <Compile Remove="ReflectedCeilingPlans.ContractTests\**\*.cs" />
    <Compile Remove="RcpQaRunner\**\*.cs" />
    <Compile Remove="RcpQaRunner.ContractTests\**\*.cs" />
    <Compile Remove="RcpNativeProtocol.ContractTests\**\*.cs" />
    <Compile Remove="ToolQaFramework.ContractTests\**\*.cs" />
    <Compile Remove="CpvPreparation.ContractTests\**\*.cs" />
    <Compile Remove="CandidateRunnerBindingCheck\**\*.cs" />
  </ItemGroup>

  <Target Name="CheckRevitApi" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RevitInstallDir)\RevitAPI.dll')"
           Text="RevitAPI.dll was not found in $(RevitInstallDir)." />

    <Error Condition="!Exists('$(RevitInstallDir)\RevitAPIUI.dll')"
           Text="RevitAPIUI.dll was not found in $(RevitInstallDir)." />
  </Target>

</Project>
