$script:QaTargetRoot='C:\Users\RepatoQA\AppData\Roaming\Autodesk\Revit\Addins\2025\RepatoQA'
function Get-QaAddinDeploymentTarget { [pscustomobject]@{TargetId='repatoqa-user-addin';TargetRoot=$script:QaTargetRoot;Allowed=$true} }
function Test-QaAddinTarget([string]$TargetRoot,[switch]$TestTarget){$full=[IO.Path]::GetFullPath($TargetRoot);if($TestTarget){if(!$full.StartsWith([IO.Path]::GetFullPath([IO.Path]::GetTempPath()),[StringComparison]::OrdinalIgnoreCase)){throw 'Test target must be temporary.'};return $full};if($full -cne $script:QaTargetRoot){throw 'Target is not the approved RepatoQA add-in directory.'};$full}
function Invoke-QaAddinDeployment { param([string]$ArtifactPath,[string]$ManifestPath,[string]$TargetRoot=$script:QaTargetRoot,[string]$TestTargetRoot,[switch]$ConfirmQaProfileDeployment,[switch]$DryRun)
 $isTest=[bool]$TestTargetRoot;if($isTest){$TargetRoot=Test-QaAddinTarget $TestTargetRoot -TestTarget}else{$TargetRoot=Test-QaAddinTarget $TargetRoot};foreach($p in @($ArtifactPath,$ManifestPath)){if(!(Test-Path -LiteralPath $p -PathType Leaf)){throw 'Deployment source is missing.'}}
 $ah=(Get-FileHash $ArtifactPath -Algorithm SHA256).Hash;$mh=(Get-FileHash $ManifestPath -Algorithm SHA256).Hash;if($DryRun){return [pscustomobject]@{TargetRoot=$TargetRoot;ArtifactSha256=$ah;ManifestSha256=$mh;SideEffectsPerformed=$false}}
 if(!$isTest -and !$ConfirmQaProfileDeployment){throw 'Explicit QA profile deployment confirmation is required.'};$a=Join-Path $TargetRoot $(if($isTest){'artifact.target'}else{'Repato.addin'});$m=Join-Path $TargetRoot $(if($isTest){'manifest.target'}else{'RepatoQA.addin'});$ab=$a+'.backup';$mb=$m+'.backup';if(!(Test-Path $a)){throw 'Target artifact is missing.'};if(!(Test-Path $m)){throw 'Target manifest is missing.'};Copy-Item $a ($ab+'.tmp') -Force;Move-Item ($ab+'.tmp') $ab -Force;Copy-Item $m ($mb+'.tmp') -Force;Move-Item ($mb+'.tmp') $mb -Force;Copy-Item $ArtifactPath ($a+'.tmp') -Force;Move-Item ($a+'.tmp') $a -Force;Copy-Item $ManifestPath ($m+'.tmp') -Force;Move-Item ($m+'.tmp') $m -Force;if((Get-FileHash $a).Hash -ne $ah -or (Get-FileHash $m).Hash -ne $mh){Copy-Item $ab $a -Force;Copy-Item $mb $m -Force;throw 'Installed hash verification failed.'};[pscustomobject]@{TargetRoot=$TargetRoot;ArtifactSha256=$ah;ManifestSha256=$mh;BackupPaths=@($ab,$mb);BackupHashes=@((Get-FileHash $ab).Hash,(Get-FileHash $mb).Hash);SideEffectsPerformed=$true}
}
Export-ModuleMember -Function Get-QaAddinDeploymentTarget,Test-QaAddinTarget,Invoke-QaAddinDeployment