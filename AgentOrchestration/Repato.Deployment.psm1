Import-Module (Join-Path $PSScriptRoot 'Repato.AgentOrchestration.psm1') -WarningAction SilentlyContinue
$script:DeployRegistry=Join-Path $PSScriptRoot 'DeploymentTargets.json'
function Get-DeploymentTargets{$r=Get-Content $script:DeployRegistry -Raw|ConvertFrom-Json;if($r.schemaVersion-ne1){throw 'Malformed deployment registry.'};$r}
function New-DeployPlan([string]$StoreRoot,[string]$TaskId,[string]$ArtifactPath,[string]$ManifestPath,[string]$TargetId,[switch]$DryRun){$root='C:\Repato-Autonomous\Source';$t=(Get-DeploymentTargets).targets|Where-Object targetId -ceq $TargetId;if(!$t-or$t.revit){throw 'Deployment target is not registered or is Revit.'};foreach($p in $ArtifactPath,$ManifestPath){$f=[IO.Path]::GetFullPath($p);if(!$f.StartsWith($root,[StringComparison]::OrdinalIgnoreCase)){throw 'Path escapes repository root.'};if(!(Test-Path $f)){throw "Missing artifact: $p"}};$a=(Get-FileHash $ArtifactPath -Algorithm SHA256).Hash;$m=(Get-FileHash $ManifestPath -Algorithm SHA256).Hash;[pscustomobject]@{schemaVersion=1;planId=[guid]::NewGuid().ToString('N');taskId=$TaskId;artifactPath=$ArtifactPath;artifactSha256=$a;manifestPath=$ManifestPath;manifestSha256=$m;targetId=$TargetId;targetPath=$t.path;mode=$(if($DryRun){'DryRun'}else{'Controlled'});sideEffectsPerformed=$false}}
function Invoke-Deploy([object]$Plan,[switch]$DryRun){if(!$DryRun){throw 'Real deployment is disabled; explicit production deployment is not enabled.'};$Plan}
function Get-DeployStatus([string]$StoreRoot,[string]$TaskId){[pscustomobject]@{TaskId=$TaskId;Status='dry-run-only';Deployments=@()}}
Export-ModuleMember -Function Get-DeploymentTargets,New-DeployPlan,Invoke-Deploy,Get-DeployStatus
