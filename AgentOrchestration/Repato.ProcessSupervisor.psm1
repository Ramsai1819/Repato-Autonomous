function Stop-SupervisorMonitor([string]$StoreRoot,[string]$TaskId,[string]$RunId){[pscustomobject]@{TaskId=$TaskId;RunId=$RunId;Stopped=$false;Reason='No automatic process termination is permitted.'}}
function Fail-SupervisorRun([string]$StoreRoot,[string]$TaskId,[string]$RunId,[string]$ErrorDetails){if([string]::IsNullOrWhiteSpace($ErrorDetails)){throw 'Failure details required.'};Invoke-RepatoStoreMutation $StoreRoot {param($d,$p)$t=Find-RepatoTask $d $TaskId;$r=Find-SupervisorRun $t $RunId;$r.status='failed';$r.errorDetails=$ErrorDetails;$t.status='failed';$t.errorDetails=$ErrorDetails;Add-RepatoHistory $t 'supervisor-failed' 'Maya' $ErrorDetails;$r}}
