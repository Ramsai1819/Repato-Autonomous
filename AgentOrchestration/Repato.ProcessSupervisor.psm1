;stdout=$out;stderr=$err;errorDetails=$error});Invoke-RepatoStoreMutation $StoreRoot {param($d,$p)$t=Find-RepatoTask $d $TaskId;$r=Find-SupervisorRun $t $RunId;$null=($r.status=if($timed-or$exit-ne0-or$error){'failed'}else{'passed'});$r.finishedUtc=$finished;$r.processId=$(if($proc){$proc.Id}else{$null});$r.exitCode=$exit;$r.timedOut=$timed;$r.stdout=$out;$r.stderr=$err;$r.logPath=$log;$r.errorDetails=$error;$t.logs=[object[]]@($t.logs)+$log;Add-RepatoHistory $t ('supervisor-'+$r.status) 'Maya' "run=$RunId";$r}}
function Get-SupervisorStatus([string]$StoreRoot,[string]$TaskId){$d=Read-RepatoTaskStore $StoreRoot;$t=Find-RepatoTask $d $TaskId;[pscustomobject]@{TaskId=$TaskId;TaskStatus=$t.status;WorkflowStage=$t.workflowStage;Runs=@($t.supervisorRuns);Logs=@($t.logs);Reports=@($t.reportPaths)}}
