Import-Module (Join-Path $PSScriptRoot 'Repato.AgentOrchestration.psm1') -WarningAction SilentlyContinue
$script:SupervisorRoot='C:\Repato-Autonomous\Source';$script:SupervisorRegistry=Join-Path $PSScriptRoot 'SupervisorAdapters.json';$script:SupervisorLogs=Join-Path $PSScriptRoot 'Logs'
function Assert-SupervisorPath([string]$Path){$full=[IO.Path]::GetFullPath($Path);$root=$script:SupervisorRoot.TrimEnd('\')+'\';if(!$full.StartsWith($root,[StringComparison]::OrdinalIgnoreCase)){throw 'Supervisor path escapes repository root.'};$full}
function Get-SupervisorRegistry{$r=Get-Content $script:SupervisorRegistry -Raw|ConvertFrom-Json;if($r.schemaVersion-ne1-or$r.repositoryRoot-ine$script:SupervisorRoot-or$null-eq$r.adapters){throw 'Malformed supervisor registry.'};foreach($p in $r.adapters.PSObject.Properties){if($p.Value.agent-notin@('Neil','Tara')-or$p.Value.entryPoint-notmatch'^AgentOrchestration/Invoke-Repato(Neil|Tara)Adapter\.ps1$'-or$p.Value.operation-notin@('neil-apply','tara-run')-or$p.Value.timeoutSeconds-lt1-or$p.Value.timeoutSeconds-gt3600){throw 'Unsafe supervisor adapter registration.'};Assert-SupervisorPath (Join-Path $script:SupervisorRoot $p.Value.entryPoint)|Out-Null};$r}
function Get-SupervisorPlanHash($run){$j=[ordered]@{adapterId=$run.adapterId;agent=$run.agent;entryPoint=$run.entryPoint;operation=$run.operation;adapterRunId=$run.adapterRunId;taskRevision=$run.taskRevision;registrySha256=$run.registrySha256}|ConvertTo-Json -Compress;$a=[Security.Cryptography.SHA256]::Create();try{([BitConverter]::ToString($a.ComputeHash([Text.Encoding]::UTF8.GetBytes($j)))).Replace('-','')}finally{$a.Dispose()}}
function Initialize-SupervisorRuns($t){if($t.PSObject.Properties.Name-notcontains'supervisorRuns'){$t|Add-Member supervisorRuns ([object[]]@())}}
function Find-SupervisorRun($t,$id){Initialize-SupervisorRuns $t;$m=@($t.supervisorRuns|Where-Object runId -ceq $id);if($m.Count-ne1){throw 'Supervisor run not found.'};$m[0]}
function New-SupervisorPlan([string]$StoreRoot,[string]$TaskId,[string]$AdapterId,[int]$TimeoutSeconds,[switch]$DryRun){Invoke-RepatoStoreMutation $StoreRoot {param($d,$preview)
 $t=Find-RepatoTask $d $TaskId;Assert-RepatoTask $t;Initialize-SupervisorRuns $t;$r=Get-SupervisorRegistry
 if(!$r.adapters.PSObject.Properties.Name.Contains($AdapterId)){throw 'Unknown adapter.'};$a=$r.adapters.$AdapterId
 if($t.assignedAgent-cne$a.agent){throw 'Task agent does not match adapter.'};if($t.workflowStage-notin @('implementation','build-checks','qa')){throw 'Task stage is not executable by an adapter.'}
 $source=if($a.agent-ceq'Neil'){@($t.neilRuns|Where-Object status -eq 'validated')[-1]}else{@($t.taraRuns|Where-Object status -eq 'validated')[-1]};if(!$source){throw 'No validated adapter run exists.'};if(@($t.supervisorRuns|Where-Object status -in @('planned','running')).Count){throw 'Active supervisor run already exists.'}
 $run=[pscustomobject][ordered]@{runId=[guid]::NewGuid().ToString('N');adapterId=$AdapterId;agent=$a.agent;entryPoint=$a.entryPoint;operation=$a.operation;adapterRunId=$source.runId;timeoutSeconds=$(if($TimeoutSeconds){[Math]::Min($TimeoutSeconds,$a.timeoutSeconds)}else{$a.timeoutSeconds});status='planned';taskRevision=[long]$t.revision;registrySha256=(Get-FileHash $script:SupervisorRegistry -Algorithm SHA256).Hash;planSha256='';processId=$null;startedUtc=$null;finishedUtc=$null;exitCode=$null;timedOut=$false;stdout=$null;stderr=$null;logPath=$null;errorDetails=$null};$run.planSha256=Get-SupervisorPlanHash $run
 if(!$preview){$t.supervisorRuns=[object[]]@($t.supervisorRuns)+$run;Add-RepatoHistory $t 'supervisor-planned' 'Maya' "adapter=$AdapterId";$run.taskRevision=[long]$t.revision};$run.planSha256=Get-SupervisorPlanHash $run;$run} -DryRun:$DryRun}
function Test-SupervisorPlan([string]$StoreRoot,[string]$TaskId,[string]$RunId){$d=Read-RepatoTaskStore $StoreRoot;$t=Find-RepatoTask $d $TaskId;$run=Find-SupervisorRun $t $RunId;$r=Get-SupervisorRegistry;if($run.status-ne'planned'){throw 'Supervisor run is not planned.'};if($run.taskRevision-ne$t.revision){throw 'Task changed after supervisor planning.'};if((Get-FileHash $script:SupervisorRegistry -Algorithm SHA256).Hash-cne$run.registrySha256-or(Get-SupervisorPlanHash $run)-cne$run.planSha256){throw 'Supervisor plan identity changed.'};[pscustomobject]@{Valid=$true;TaskId=$TaskId;RunId=$RunId;PlanSha256=$run.planSha256}}
function Request-SupervisorApproval([string]$StoreRoot,[string]$TaskId,[string]$RunId,[int]$ExpiryMinutes=30){Invoke-RepatoStoreMutation $StoreRoot {param($d,$p)$t=Find-RepatoTask $d $TaskId;$run=Find-SupervisorRun $t $RunId;if($run.status-ne'planned'-or$run.taskRevision-ne$t.revision-or(Get-SupervisorPlanHash $run)-cne$run.planSha256){throw 'Supervisor plan is stale.'};if(@($t.approvalRequests|Where-Object status -ceq 'pending').Count){throw 'Task already has a pending approval.'};$q=[pscustomobject]@{requestId=[guid]::NewGuid().ToString('N');action=('supervisor:'+ $run.adapterId);requiredLevel='maya';status='pending';bindingHash=$run.planSha256;previousStatus=$t.status;requestedRevision=[long]0;approvedRevision=$null;requestedUtc=Get-RepatoUtc;expiresUtc=[DateTimeOffset]::UtcNow.AddMinutes($ExpiryMinutes).ToString('O');decidedUtc=$null;decidedBy=$null;reason=$null;consumedUtc=$null};$t.approvalRequests=[object[]]@($t.approvalRequests)+$q;$t.status='awaiting-approval';Add-RepatoHistory $t 'supervisor-approval-requested' 'Maya' "run=$RunId";$q;$q.requestedRevision=[long]$t.revision} }
function Assert-SupervisorApproval($t,$run){$m=@($t.approvalRequests|Where-Object{$_.action-ceq('supervisor:'+ $run.adapterId)-and$_.status-ceq'approved'-and$_.bindingHash-ceq$run.planSha256-and$null-eq$_.consumedUtc});if($m.Count-ne1){throw 'Missing, expired, or mismatched supervisor approval.'};if([DateTimeOffset]::Parse($m[0].expiresUtc)-le[DateTimeOffset]::UtcNow-or$m[0].approvedRevision-ne$t.revision){throw 'Supervisor approval expired or task changed.'};$m[0]}
function Get-SupervisorPreview([string]$StoreRoot,[string]$TaskId,[string]$RunId){$d=Read-RepatoTaskStore $StoreRoot;$t=Find-RepatoTask $d $TaskId;$run=Find-SupervisorRun $t $RunId;[pscustomobject]@{Mode='DryRun';TaskId=$TaskId;RunId=$RunId;AdapterId=$run.adapterId;EntryPoint=$run.entryPoint;Operation=$run.operation;AdapterRunId=$run.adapterRunId;TimeoutSeconds=$run.timeoutSeconds;WouldStart="powershell.exe -NoProfile -ExecutionPolicy Bypass -File $($run.entryPoint) $($run.operation) -TaskId $TaskId -RunId $($run.adapterRunId)";SideEffectsPerformed=$false}}
function Invoke-SupervisorStart([string]$StoreRoot,[string]$TaskId,[string]$RunId,[switch]$DryRun){if($DryRun){return Get-SupervisorPreview $StoreRoot $TaskId $RunId};$start=Invoke-RepatoStoreMutation $StoreRoot {param($d,$p)$t=Find-RepatoTask $d $TaskId;$run=Find-SupervisorRun $t $RunId;if($run.status-ne'planned'){throw 'Duplicate or invalid supervisor launch.'};$approval=Assert-SupervisorApproval $t $run;$approval.consumedUtc=Get-RepatoUtc;$run.status='running';$run.startedUtc=Get-RepatoUtc;$run.processId=$null;[pscustomobject]@{Adapter=$run.entryPoint;Operation=$run.operation;AdapterRunId=$run.adapterRunId;Timeout=$run.timeoutSeconds;StartedUtc=$run.startedUtc}}
    $sw=[Diagnostics.Stopwatch]::StartNew();$out='';$err='';$exit=-1;$timed=$false;$error=$null;$proc=$null;try{$i=[Diagnostics.ProcessStartInfo]::new();$i.FileName='C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe';$i.Arguments="-NoProfile -ExecutionPolicy Bypass -File `"$(Join-Path $script:SupervisorRoot $start.Adapter)`" $start.Operation -TaskId $TaskId -RunId $start.AdapterRunId";$i.WorkingDirectory=$script:SupervisorRoot;$i.UseShellExecute=$false;$i.CreateNoWindow=$true;$i.RedirectStandardOutput=$true;$i.RedirectStandardError=$true;$proc=[Diagnostics.Process]::Start($i);$outTask=$proc.StandardOutput.ReadToEndAsync();$errTask=$proc.StandardError.ReadToEndAsync();if(!$proc.WaitForExit($start.Timeout*1000)){$timed=$true;$err='Supervisor timeout elapsed; process was not killed.'}else{$out=$outTask.Result;$err=$errTask.Result;$exit=$proc.ExitCode}}catch{$error=$_.Exception.ToString();$err=$error}finally{$sw.Stop()};$finished=Get-RepatoUtc;New-Item $script:SupervisorLogs -ItemType Directory -Force|Out-Null;$log=Join-Path $script:SupervisorLogs "$TaskId-$RunId.supervisor.json";Write-RepatoJsonAtomic $log ([ordered]@{schemaVersion=1;taskId=$TaskId;runId=$RunId;processId=$(if($proc){$proc.Id}else{$null});startedUtc=$start.StartedUtc;finishedUtc=$finished;durationMilliseconds=$sw.Elapsed.TotalMilliseconds;exitCode=$exit;timedOut=$timed;stdout=$out;stderr=$err;errorDetails=$error});Invoke-RepatoStoreMutation $StoreRoot {param($d,$p)$t=Find-RepatoTask $d $TaskId;$r=Find-SupervisorRun $t $RunId;$r.status=if($timed-or$exit-ne0-or$error){'failed'}else{'passed'};$r.finishedUtc=$finished;$r.exitCode=$exit;$r.timedOut=$timed;$r.stdout=$out;$r.stderr=$err;$r.logPath=$log;$r.errorDetails=$error;if($r.status-eq'failed'){$t.status='failed';$t.errorDetails=if($error){$error}else{if($timed){'Supervisor timeout'}else{"Adapter exited $exit"}}};$t.logs=[object[]]@($t.logs)+$log;Add-RepatoHistory $t ('supervisor-'+$r.status) 'Maya' "run=$RunId";$r}}
function Invoke-SupervisorStart([string]$StoreRoot,[string]$TaskId,[string]$RunId,[switch]$DryRun){if($DryRun){return Get-SupervisorPreview $StoreRoot $TaskId $RunId};$start=@(Invoke-RepatoStoreMutation $StoreRoot {param($d,$p)$t=Find-RepatoTask $d $TaskId;$run=Find-SupervisorRun $t $RunId;if($run.status-ne'planned'){throw 'Duplicate or invalid supervisor launch.'};$null=Assert-SupervisorApproval $t $run;$null=($run.status='running');$null=($run.startedUtc=Get-RepatoUtc);[pscustomobject]@{Adapter=$run.entryPoint;Operation=$run.operation;AdapterRunId=$run.adapterRunId;Timeout=$run.timeoutSeconds;StartedUtc=$run.startedUtc}})[-1]
